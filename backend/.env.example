APP_ENV=development
# Local SQLite quickstart; use PostgreSQL in Compose and production.
DATABASE_URL=sqlite:///./devprobe.db
AUTH_ENABLED=false
REGISTRATION_ENABLED=true
PUBLIC_URL=http://localhost:3000
SESSION_TTL_SECONDS=86400
SCAN_MODE=sync
REDIS_URL=redis://127.0.0.1:6379/0
# Only for unscoped local development. Organization-private repositories require the App.
GITHUB_TOKEN=
GITHUB_TIMEOUT_SECONDS=10
GITHUB_MAX_PAGES=30
GITHUB_MAX_RESPONSE_BYTES=8388608
# Leave empty for the basic analyzer; install backend/tools before enabling all tools.
EXTERNAL_ANALYZERS=
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_INPUT_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
