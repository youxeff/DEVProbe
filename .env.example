# Local Compose setup. Use a generated, URL-safe password; never commit .env.
POSTGRES_PASSWORD=
APP_ENV=development
GITHUB_TOKEN=
EXTERNAL_ANALYZERS=bandit,radon,eslint,semgrep
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional current per-million token rates; blank keeps estimated cost unknown.
AI_INPUT_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=
