# Copy to .env. Values here are empty placeholders, not credentials.
# Generate a URL-safe password, e.g. python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
APP_ENV=development
AUTH_ENABLED=true
REGISTRATION_ENABLED=true
PUBLIC_URL=http://localhost:3000
# PAT applies only to AUTH_ENABLED=false local mode; use the App for organization-private repos.
GITHUB_TOKEN=
EXTERNAL_ANALYZERS=bandit,radon,eslint,semgrep
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional verified current per-million rates; blank keeps estimated cost unknown.
AI_INPUT_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=
# GitHub App: escaped \n in the PEM value is supported.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional hosted billing. Start with Stripe test-mode credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
